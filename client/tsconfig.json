{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vite/client"],
    "composite": false,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../shared" }
  ]
}
